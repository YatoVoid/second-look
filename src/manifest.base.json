{
  "manifest_version": 3,
  "name": "Second Look for Devpost",
  "short_name": "Second Look",
  "version": "0.1.0",
  "description": "Private triage aid for Devpost judges. Marks projects whose text closely matches other public work so a person can review them.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://devpost.com/*",
    "https://*.devpost.com/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Second Look",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js",
        "lib/*.js",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://devpost.com/*",
        "https://*.devpost.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
